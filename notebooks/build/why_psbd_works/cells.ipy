# %% fusion
FUSION_SOURCE = "`results/_experiments/cache_readouts/fusion_rules_holdout.json`, `summary.adaptive.<partner>.all`"
# The plain minimum of the 2 clean-validation percentiles is the fusion rule the
# user chose: an OR of 2 probes with no weight to tune. The plain average of the 2
# fractional PSUs is the robustness check, and the weighted minimum was tried and set
# aside because its weight has no principled value.
PICKED_RULE = "min_rank"
ROBUSTNESS_RULE = "mean_psu"
SET_ASIDE_RULE = "weighted_0.9_0.1"
# The partner is the middle band (pre_residual_blocks_5_8), the paper's best residual
# placement. The late band (pre_residual_blocks_9_12) is the partner the
# pre-registration picked, reported beside it.
PARTNER, OTHER_PARTNER = "middle_band", "late_band"
PARTNER_LABELS = {"middle_band": "blocks 5 to 8", "late_band": "blocks 9 to 12"}
ONSET_SOURCE = "experiments/backdoor_direction_layers/README.md"


def onset_table(path):
    # The onset table is read from the README because the experiment wrote no JSON
    # record. Rows look like "| `blend` | global blended | **5** |".
    rows = re.findall(
        r"^\| `(\w+)` \| [^|]+ \| \**(\d+)\** \|$", Path(path).read_text(), flags=re.M
    )
    table = {attack: int(layer) for attack, layer in rows}
    return table


if readout_verdicts is not None and None not in fusion.values():
    held_out_summary = fusion["holdout"]["summary"]["adaptive"]
    panel_summary = fusion["panel"]["summary"]["adaptive"]
    held_out_fusion = held_out_summary[PARTNER]["all"]
    held_out_other = held_out_summary[OTHER_PARTNER]["all"]
    budgets = [f"q{q:.2f}" for q in fusion["holdout"]["quantiles"]]
    low_budgets = [b for b in budgets if float(b[1:]) <= 0.1]

    figure, axes = plt.subplots(1, 2, figsize=(11, 3.6))
    plotted = {}
    curves = (
        ("tm_alone", held_out_fusion, f"{TM} alone", CONTROL_COLOR, "-"),
        (
            PICKED_RULE,
            held_out_fusion,
            f"plain minimum, {PARTNER_LABELS[PARTNER]}",
            OKABE_ITO[0],
            "-",
        ),
        (
            ROBUSTNESS_RULE,
            held_out_fusion,
            f"plain average, {PARTNER_LABELS[PARTNER]}",
            OKABE_ITO[2],
            "--",
        ),
        (
            PICKED_RULE,
            held_out_other,
            f"plain minimum, {PARTNER_LABELS[OTHER_PARTNER]}",
            OKABE_ITO[1],
            ":",
        ),
    )
    for rule, summary, label, color, style in curves:
        fpr = [summary[rule][f"{b}:realized_fpr"]["mean"] for b in budgets]
        tpr = [summary[rule][f"{b}:tpr"]["mean"] for b in budgets]
        axes[0].plot(fpr, tpr, marker="o", color=color, linestyle=style, label=label)
        plotted[label] = {"realized_fpr": fpr, "tpr": tpr}
    axes[0].set_xscale("log")
    axes[0].set_xlabel("realized FPR on the paired clean images (log)")
    axes[0].set_ylabel("TPR, mean over models")
    axes[0].set_title(f"held-out set, {held_out_fusion['n']} models")
    axes[0].legend(fontsize=6)

    per_model = pd.DataFrame(
        [
            {
                "folder": model["folder"],
                "attack": model["attack"],
                "tm_alone": model["partners"]["adaptive"][PARTNER]["rules"]["tm_alone"][
                    "at_fpr"
                ]["q0.01"]["tpr"],
                "fused": model["partners"]["adaptive"][PARTNER]["rules"][PICKED_RULE][
                    "at_fpr"
                ]["q0.01"]["tpr"],
            }
            for model in fusion["holdout"]["models"]
        ]
    )
    for attack, group in per_model.groupby("attack"):
        axes[1].scatter(
            group["tm_alone"],
            group["fused"],
            s=14,
            color=ATTACK_COLORS.get(attack),
            label=attack_label(attack),
        )
    axes[1].plot([0, 1], [0, 1], color="grey", linestyle=":")
    axes[1].set_xlabel(f"{TM} alone, TPR at 1% FPR")
    axes[1].set_ylabel(f"plain minimum with {PARTNER_LABELS[PARTNER]}, TPR at 1% FPR")
    axes[1].set_title("per held-out model")
    axes[1].legend(fontsize=6)
    plotted["per_model_tpr_at_1pct"] = per_model.to_dict("records")
    save_figure(figure, "fusion_low_fpr", [FUSION_SOURCE], plotted)

    def tpr_by_budget(reading):
        text = "/".join(number(reading[f"{b}:tpr"]["mean"]) for b in low_budgets)
        return text

    budget_names = "/".join(f"{float(b[1:]):.0%}" for b in low_budgets)
    picked = held_out_fusion[PICKED_RULE]
    gain_text = ", ".join(
        f"{signed(picked[f'{b}:tpr']['mean_difference'])} [{signed(picked[f'{b}:tpr']['ci95'][0])}, "
        f"{signed(picked[f'{b}:tpr']['ci95'][1])}] at {float(b[1:]):.0%}"
        for b in low_budgets
    )
    partner_panel = panel_summary[PARTNER]
    other_panel = panel_summary[OTHER_PARTNER]
    wanet_fusion = partner_panel["by_attack"]["wanet"][PICKED_RULE]["auroc"]
    tact_fusion = partner_panel["by_attack"].get("tact")
    tact_text = ""
    if tact_fusion:
        tact_models = tact_fusion[PICKED_RULE]["q0.10:tpr"]["n"]
        tact_text = (
            f" The cost is on TaCT, which the held-out set does not contain: on the panel its TPR at 10% FPR falls from "
            f"{number(tact_fusion['tm_alone']['q0.10:tpr']['mean'])} to {number(tact_fusion[PICKED_RULE]['q0.10:tpr']['mean'])} "
            f"over {tact_models} TaCT model{'' if tact_models == 1 else 's'}."
        )
    onsets = onset_table(ONSET_SOURCE)
    onset_text = ", ".join(
        f"{attack_label(a)} {layer}"
        for a, layer in sorted(onsets.items(), key=lambda item: item[1])
        if a in PANEL_ATTACK.values()
    )
    register(
        "C34",
        "s10",
        f"Flagging an input when either {TM} or residual dropout in blocks 5 to 8 flags it, the plain minimum of their clean-validation percentiles, detects more at low FPR",
        "ours, `experiments/cache_readouts/`, the rule and partner the user chose",
        # The middle band was chosen after the held-out read showed it tying the
        # pre-registered late band, so this read describes the choice and does not
        # confirm it. The Swin-S slot of the plan is the independent confirmation.
        "partial",
        f"on the {held_out_fusion['n']} held-out models TPR at {budget_names} FPR is {tpr_by_budget(picked)} fused with {PARTNER_LABELS[PARTNER]} "
        f"against {tpr_by_budget(held_out_fusion['tm_alone'])} for {TM} alone, paired gains {gain_text}, at a realized FPR of "
        f"{number(picked['q0.01:realized_fpr']['mean'])} for the 1% budget. The late band ties at {tpr_by_budget(held_out_other[PICKED_RULE])}. "
        f"The plain average of the 2 fractional PSUs reads {tpr_by_budget(held_out_fusion[ROBUSTNESS_RULE])}, so the gain comes from "
        f"adding the second probe and not from the combination rule. On the panel's WaNet models the fused AUROC is "
        f"{number(wanet_fusion['mean'])} against {number(wanet_fusion['reference_mean'])}.{tact_text} The middle band reaches the "
        f"adaptive rate on {partner_panel['n_models']} of {partner_panel['n_models'] + len(partner_panel['missing'])} panel models, the late band on "
        f"{other_panel['n_models']}. It is the paper's best residual placement "
        f"(`\\BestResidualGain` {macro('BestResidualGain')} [{macro('BestResidualGainLow')}, {macro('BestResidualGainHigh')}]). "
        f"Direction onset by attack from `{ONSET_SOURCE}`, which has no JSON record behind it: {onset_text}",
        f"{TM} alone on the same models and passes, each score thresholded at its own clean-validation quantile, and the late band as the alternative partner",
        f"{FUSION_SOURCE}, `fusion_rules_panel.json` `summary.adaptive.<partner>.by_attack` and `.missing`, `paper/headline.json` `BestResidualGain`",
    )
    show(
        f"A weighted minimum ({SET_ASIDE_RULE.replace('_', ' ')}, TPR {tpr_by_budget(held_out_fusion[SET_ASIDE_RULE])} with "
        f"{PARTNER_LABELS[PARTNER]}) was also tried and is not used, since its weight has no principled value."
    )
    # The post-hoc band comparison of experiments/cache_readouts/: every residual band
    # as the union partner, per attack, under both rules. It was requested after the
    # confirmation read and makes no pick, so it is labeled post-hoc throughout.
    bands = [
        b for b in ("early_band", "middle_band", "late_band") if b in panel_summary
    ]
    band_labels = {"early_band": "blocks 1 to 4", **PARTNER_LABELS}
    band_attacks = ("wanet", "tact", "badnet_a2o")
    band_rules = ((PICKED_RULE, "plain minimum"), (ROBUSTNESS_RULE, "plain average"))
    figure, axes = plt.subplots(
        len(band_attacks), len(band_rules), figsize=(10, 8), sharex=True, squeeze=False
    )
    band_plotted = {}
    for row, attack in enumerate(band_attacks):
        for column, (rule, rule_label) in enumerate(band_rules):
            axis = axes[row, column]
            reference = panel_summary[PARTNER]["by_attack"][attack]["tm_alone"]
            axis.plot(
                [float(b[1:]) for b in low_budgets],
                [reference[f"{b}:tpr"]["mean"] for b in low_budgets],
                marker="o",
                color=CONTROL_COLOR,
                linewidth=2,
                label=f"{TM} alone ({reference['q0.01:tpr']['n']})",
            )
            for index, name in enumerate(bands):
                reading = panel_summary[name]["by_attack"].get(attack)
                if reading is None:
                    continue
                values = [reading[rule][f"{b}:tpr"]["mean"] for b in low_budgets]
                axis.plot(
                    [float(b[1:]) for b in low_budgets],
                    values,
                    marker="o",
                    color=OKABE_ITO[index + 1],
                    label=f"{band_labels[name]} ({reading[rule]['q0.01:tpr']['n']})",
                )
                band_plotted[f"{attack}|{rule}|{name}"] = dict(zip(low_budgets, values))
                # A band that misses the adaptive rate on some models is read on fewer
                # models, so its own PSBD-TM reference is drawn dotted beside it.
                if reading[rule]["q0.01:tpr"]["n"] != reference["q0.01:tpr"]["n"]:
                    own_reference = [
                        reading["tm_alone"][f"{b}:tpr"]["mean"] for b in low_budgets
                    ]
                    axis.plot(
                        [float(b[1:]) for b in low_budgets],
                        own_reference,
                        linestyle=":",
                        color=OKABE_ITO[index + 1],
                        label=f"{TM} alone on the same {reading[rule]['q0.01:tpr']['n']}",
                    )
                    band_plotted[f"{attack}|tm_alone|{name}"] = dict(
                        zip(low_budgets, own_reference)
                    )
            axis.set_xscale("log")
            axis.set_title(
                f"{attack_label(attack)}, {rule_label}, post-hoc", fontsize=8
            )
            if column == 0:
                axis.set_ylabel("TPR, panel, adaptive rate")
            if row == len(band_attacks) - 1:
                axis.set_xlabel("FPR budget")
            axis.legend(fontsize=6)
    save_figure(
        figure,
        "fusion_band_comparison",
        [
            "`results/_experiments/cache_readouts/fusion_rules_panel.json`, `summary.adaptive.<band>.by_attack`"
        ],
        band_plotted,
    )

    def attack_tpr(name, attack, rule, budget="q0.01"):
        reading = panel_summary[name]["by_attack"].get(attack)
        value = reading[rule][f"{budget}:tpr"]["mean"] if reading else None
        return value

    def attack_reference(name, attack, budget="q0.01"):
        reading = panel_summary[name]["by_attack"].get(attack)
        value = reading["tm_alone"][f"{budget}:tpr"]["mean"] if reading else None
        return value

    held_out_changes = {
        name: held_out_summary[name]["all"][PICKED_RULE]["q0.01:tpr"]["mean_difference"]
        for name in bands
    }
    wanet_gain = {
        name: attack_tpr(name, "wanet", PICKED_RULE) - attack_reference(name, "wanet")
        for name in bands
    }
    tact_cost = {
        name: attack_tpr(name, "tact", PICKED_RULE, "q0.10")
        - attack_reference(name, "tact", "q0.10")
        for name in bands
        if attack_tpr(name, "tact", PICKED_RULE, "q0.10") is not None
    }
    badnets_raised = [
        name
        for name in bands
        if attack_tpr(name, "badnet_a2o", PICKED_RULE)
        > attack_reference(name, "badnet_a2o")
    ]
    coverage = {name: panel_summary[name]["n_models"] for name in bands}
    panel_size = panel_summary[PARTNER]["n_models"] + len(
        panel_summary[PARTNER]["missing"]
    )
    show(
        "**Band comparison, post-hoc.** Read after the confirmation and making no pick "
        "(`fusion_rules_<set>.json`, `summary.adaptive.<band>`), plain minimum at 1% FPR. "
        + "On the held-out set the change against PSBD-TM alone is "
        + ", ".join(
            f"{signed(held_out_changes[n])} with {band_labels[n]}" for n in bands
        )
        + ". On the panel's WaNet models the gain is "
        + ", ".join(f"{signed(wanet_gain[n])} with {band_labels[n]}" for n in bands)
        + ". The change in TaCT TPR at 10% FPR is "
        + ", ".join(
            f"{signed(v)} with {band_labels[n]} ({tact_models} model{'' if tact_models == 1 else 's'})"
            for n, v in tact_cost.items()
            for tact_models in [
                panel_summary[n]["by_attack"]["tact"][PICKED_RULE]["q0.10:tpr"]["n"]
            ]
        )
        + ". In TaCT AUROC the fused reading is "
        + ", ".join(
            f"{number(panel_summary[n]['by_attack']['tact'][PICKED_RULE]['auroc']['mean'])} with {band_labels[n]}"
            for n in tact_cost
        )
        + f" against {number(panel_summary[PARTNER]['by_attack']['tact']['tm_alone']['auroc']['mean'])} for {TM} alone"
        + ". BadNets TPR at 1% FPR rises only with "
        + (
            ", ".join(band_labels[n] for n in badnets_raised)
            if badnets_raised
            else "no band"
        )
        + ". Coverage of the adaptive rate: "
        + ", ".join(f"{band_labels[n]} {coverage[n]} of {panel_size}" for n in bands)
        + ". These are post-hoc readings on few WaNet and TaCT models, hypotheses for the pre-registered Swin-S test."
    )

    missing = other_panel["missing"]
    largest = max(m["max_validation_shift"] for m in missing)
    ladder_lengths = {len(m["rates_cached"]) for m in missing}
    show(
        f"**The late-band fill is withdrawn.** {len(missing)} panel models never reach the adaptive target "
        f"{ADAPTIVE_SHIFT_TARGET} with late-band residual dropout. Each already holds a ladder of "
        f"{', '.join(str(n) for n in sorted(ladder_lengths))} cached rates up to "
        f"{number(max(max(m['rates_cached']) for m in missing), 2)}, and their largest clean-validation shift is at most "
        f"{number(largest)}, so a fill run would give them no adaptive rate "
        "(`fusion_rules_panel.json`, `summary.adaptive.late_band.missing[]`)."
    )

# The fusion spends 2 sets of k passes, so the fair control is PSBD-TM alone with as
# many passes. No record compares them yet, and the k = 20 caches it needs are still
# being written, so the claim is open and the cell counts what has landed.
k20_panel = [
    folder
    for folder in PANEL
    if (Path("results") / folder / "psbd" / f"{RECOMMENDED_PLACEMENT}_k20").is_dir()
]
register(
    "C35",
    "s10",
    f"The fusion's gain is not the extra passes: {TM} alone at k = 6 does not match the fusion at 3 plus 3 passes",
    "compute control asked for by the coordinator",
    "open",
    f"no record compares them yet. {len(k20_panel)} of {len(PANEL)} panel models have a {TM} k = 20 cache",
    f"{TM} at twice the passes, the same compute as the fusion",
    f"`results/<folder>/psbd/{RECOMMENDED_PLACEMENT}_k20/`, pending",
)

# %% general
GENERAL_HYPOTHESES = {
    "margin": (
        "H-margin",
        "The triggered decision keeps its logit margin under perturbation while the clean margin collapses",
        "memo L1, P1",
    ),
    "direction": (
        "H-direction",
        "The triggered feature is dominated by a backdoor direction the perturbation dents less than clean class evidence",
        "Karayalçin et al., memo L8",
    ),
    "redundancy": (
        "H-redundancy",
        "Trigger evidence is repeated across tokens",
        "memo L19, L23",
    ),
    "low_dim": (
        "H-low-dim",
        "The triggered decision depends on few dimensions or a small part of the input",
        "Cognitive Distillation, memo L6, L9",
    ),
    "flatness": (
        "H-flatness",
        "Triggered inputs sit in a flatter region and the statistic estimates curvature",
        "memo L2, P4",
    ),
    "neuron_bias": (
        "H-neuron-bias",
        "Shifted clean predictions fall onto the target, so removing the target's gain costs AUROC",
        "Li et al., memo L10, P6",
    ),
    "pass_uncertainty": (
        "pass uncertainty",
        "The statistic is MC-dropout uncertainty over the passes",
        "Li et al.'s framing, memo P2",
    ),
    "missingness": (
        "missingness",
        "A zeroed token is native missingness, so substituting another token does as well",
        "Jain et al., memo L22",
    ),
}
# The 4 categories with a successful model on the 4 paper datasets. Frequency
# (SIG) is quarantined by the audit of 2026-09-29, so it is not required.
REQUIRED_CATEGORIES = ("patch", "blend", "warp", "quantization")
STATUS_VALUES = {"supported": 1.0, "partial": 0.5, "refuted": 0.0}
if why_summary is None:
    for index, (key, (name, claim, who)) in enumerate(GENERAL_HYPOTHESES.items()):
        register(
            f"C{36 + index}",
            "s11",
            claim,
            who,
            "pending",
            "pending",
            "benign probes",
            WHY_SOURCE,
        )
else:
    verdicts = why_summary["verdicts"]
    cells = []
    for architecture, groups in verdicts.items():
        for group, entries in groups.items():
            for key in GENERAL_HYPOTHESES:
                entry = entries.get(key, {})
                cells.append(
                    {
                        "architecture": architecture,
                        "group": group,
                        "hypothesis": key,
                        "status": entry.get("status"),
                        "value": entry.get("value"),
                    }
                )
    cells = pd.DataFrame(cells)
    rows = sorted(
        cells[["architecture", "group"]].drop_duplicates().itertuples(index=False)
    )
    grid = np.full((len(rows), len(GENERAL_HYPOTHESES)), np.nan)  # (groups, hypotheses)
    figure, axis = plt.subplots(figsize=(11, 0.4 * len(rows) + 1.5))
    for i, (architecture, group) in enumerate(rows):
        for j, key in enumerate(GENERAL_HYPOTHESES):
            cell = cells[
                (cells["architecture"] == architecture)
                & (cells["group"] == group)
                & (cells["hypothesis"] == key)
            ].iloc[0]
            grid[i, j] = STATUS_VALUES.get(cell["status"], np.nan)
            text = cell["status"] or "no data"
            if pd.notna(cell["value"]):
                text += f"\n{cell['value']:.2f}"
            axis.text(j, i, text, ha="center", va="center", fontsize=6)
    axis.imshow(grid, cmap="RdYlGn", vmin=0, vmax=1, aspect="auto")
    axis.set_xticks(
        np.arange(len(GENERAL_HYPOTHESES)),
        [v[0] for v in GENERAL_HYPOTHESES.values()],
        rotation=20,
    )
    axis.set_yticks(
        np.arange(len(rows)), [f"{ARCHITECTURE_LABELS[a]} {g}" for a, g in rows]
    )
    axis.set_title("status and key number per group, green supported, red refuted")
    save_figure(
        figure, "general_principles", [WHY_SOURCE], {"cells": cells.to_dict("records")}
    )

    measured = sorted(
        {
            group
            for groups in verdicts.values()
            for group in groups
            if not group.startswith("benign")
        }
    )
    missing_categories = [
        c for c in REQUIRED_CATEGORIES if not any(g.startswith(c) for g in measured)
    ]
    for index, (key, (name, claim, who)) in enumerate(GENERAL_HYPOTHESES.items()):
        statuses = cells[
            (cells["hypothesis"] == key) & ~cells["group"].str.startswith("benign")
        ]
        text = ", ".join(
            f"{row.group} {row.status} ({number(row.value)})"
            for row in statuses.itertuples()
        )
        if missing_categories:
            verdict = "open"
        else:
            status_set = set(statuses["status"])
            verdict = (
                "true"
                if status_set == {"supported"}
                else "false"
                if status_set == {"refuted"}
                else "partial"
            )
        benign = cells[
            (cells["hypothesis"] == key) & cells["group"].str.startswith("benign")
        ]
        register(
            f"C{36 + index}",
            "s11",
            f"{name}: {claim}",
            who,
            verdict,
            text
            + (
                f". Not yet measured: {', '.join(missing_categories)}"
                if missing_categories
                else ""
            ),
            "benign models probed with a patch and a global trigger: "
            + ", ".join(f"{row.group} {row.status}" for row in benign.itertuples()),
            f"{WHY_SOURCE}, `verdicts.<architecture>.<group>.{key}`",
        )
    target_easy = why_summary["panel_verdicts"]["target_easy"]
    statuses = {attack: entry["status"] for attack, entry in target_easy.items()}
    register(
        f"C{36 + len(GENERAL_HYPOTHESES)}",
        "s11",
        "The target class is easy, so any image predicted as the target scores low",
        "reviewer reading P10",
        "true"
        if set(statuses.values()) == {"supported"}
        else "false"
        if set(statuses.values()) == {"refuted"}
        else "partial",
        "clean target-class images flagged by PSBD-TM: "
        + ", ".join(
            f"{attack_label(a)} {number(e['value'])} ({e['status']})"
            for a, e in target_easy.items()
        )
        + f", against {number(next(iter(target_easy.values()))['benign'])} on the benign references and a base rate of {HEADLINE_QUANTILE}",
        "benign references and the base rate of the quantile threshold",
        f"{WHY_SOURCE}, `panel_verdicts.target_easy`",
    )

# %% claims_table
SECTION_TITLES = {
    "s1": "Li et al.'s account",
    "s2": "breaking-point curves",
    "s3": "patch-trigger routing",
    "s4": "clean fragility",
    "s5": "alternative explanations",
    "s6": "neurons and directions",
    "s7": "WaNet",
    "s8": "global-trigger redundancy",
    "s9": "where the backdoor lives",
    "s10": "pass statistics, depth bands and fusion",
    "s11": "general principles",
}


def claims_markdown(claims):
    lines = [
        "| id | claim | made by | verdict | key number | control | evidence (file, field) |",
        "|---|---|---|---|---|---|---|",
    ]
    for row in claims:
        cells = [
            f"[{row['id']}](#{row['section']})",
            row["claim"],
            row["who"],
            f"**{row['verdict']}**",
            row["key"],
            row["control"],
            row["source"],
        ]
        lines.append("| " + " | ".join(cell.replace("|", "/") for cell in cells) + " |")
    table = "\n".join(lines)
    return table


counts = pd.Series([row["verdict"] for row in CLAIMS]).value_counts()
summary_line = (
    f"{len(CLAIMS)} claims: "
    + ", ".join(f"{counts.get(v, 0)} {v}" for v in VERDICTS)
    + ". Sections: "
    + ", ".join(f"[{title}](#{sid})" for sid, title in SECTION_TITLES.items())
    + "."
)
table = summary_line + "\n\n" + claims_markdown(CLAIMS)
update_display(Markdown(table), display_id="claims-table")
Path(FIGURE_DIR / "claims.json").write_text(json.dumps(CLAIMS, indent=2))
show(table)

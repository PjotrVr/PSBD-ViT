    panel_checks = depth_bands["verdicts"]["top_rate"]
    e1a_badnets = [c for c in panel_checks["E1a"]["checks"] if "badnet" in c["folder"]]
    e1a_held = sum(c["holds"] for c in e1a_badnets)
